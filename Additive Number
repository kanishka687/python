class Solution:
    def isAdditiveNumber(self, num: str) -> bool:
        n = len(num)
        
        # Try all possible first two numbers
        # i and j are the lengths of the first and second numbers
        for i in range(1, n):
            for j in range(1, n - i):
                s1 = num[:i]
                s2 = num[i : i + j]
                
                # Check for invalid leading zeros
                if (len(s1) > 1 and s1[0] == '0') or (len(s2) > 1 and s2[0] == '0'):
                    continue
                
                if self.isValid(s1, s2, num[i + j :]):
                    return True
        return False

    def isValid(self, s1: str, s2: str, remaining: str) -> bool:
        if not remaining:
            return True
        
        # Calculate expected next number
        res = str(int(s1) + int(s2))
        
        # Check if the remaining string starts with our expected sum
        if not remaining.startswith(res):
            return False
            
        # Recurse: s2 is now the first number, res is the second
        return self.isValid(s2, res, remaining[len(res) :])
