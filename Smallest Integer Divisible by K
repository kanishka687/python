class Solution:
    def smallestRepunitDivByK(self, k: int) -> int:
        # If k is even or divisible by 5, no number ending in 1 
        # can ever be divisible by k.
        if k % 2 == 0 or k % 5 == 0:
            return -1
        
        remainder = 0
        # There are only k possible remainders (0 to k-1).
        # We only need to check up to k lengths.
        for length in range(1, k + 1):
            # Form the next number (1, 11, 111...) using modulo
            remainder = (remainder * 10 + 1) % k
            
            if remainder == 0:
                return length
                
        return -1
