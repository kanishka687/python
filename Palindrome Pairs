class Solution:
    def palindromePairs(self, words: list[str]) -> list[list[int]]:
        # Map reversed word to its index for O(1) lookup
        rev_map = {w[::-1]: i for i, w in enumerate(words)}
        res = []
        
        for i, word in enumerate(words):
            # Try every possible split point in the word
            # Using len(word) + 1 to include the empty suffix
            for j in range(len(word) + 1):
                prefix = word[:j]
                suffix = word[j:]
                
                # Case 1: Prefix is palindrome, look for reversed suffix
                if prefix == prefix[::-1]:
                    target = suffix
                    if target in rev_map and rev_map[target] != i:
                        res.append([rev_map[target], i])
                
                # Case 2: Suffix is palindrome, look for reversed prefix
                # j > 0 prevents double-counting the full word case from above
                if j > 0 and suffix == suffix[::-1]:
                    target = prefix
                    if target in rev_map and rev_map[target] != i:
                        res.append([i, rev_map[target]])
                        
        return res
