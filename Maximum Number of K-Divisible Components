import sys

# Increase recursion depth for deep trees
sys.setrecursionlimit(10**5)

class Solution:
    def maxKDivisibleComponents(self, n: int, edges: list[list[int]], values: list[int], k: int) -> int:
        # Build adjacency list
        adj = [[] for _ in range(n)]
        for u, v in edges:
            adj[u].append(v)
            adj[v].append(u)
            
        self.components = 0
        
        def dfs(u, p):
            # Start with the current node's value
            current_sum = values[u]
            
            for v in adj[u]:
                if v != p:
                    # Add the sum returned by the child subtree
                    current_sum += dfs(v, u)
            
            # If the current subtree sum is divisible by k, 
            # it forms a new valid component.
            if current_sum % k == 0:
                self.components += 1
                return 0 # We "cut" this component, so it contributes 0 to parent
            
            return current_sum % k
        
        dfs(0, -1)
        return self.components
