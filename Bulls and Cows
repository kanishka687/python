from collections import defaultdict

class Solution:
    def getHint(self, secret: str, guess: str) -> str:
        bulls = 0
        cows = 0
        count = defaultdict(int)
        
        for s, g in zip(secret, guess):
            if s == g:
                bulls += 1
            else:
                # If count[s] was negative, guess had this digit before
                if count[s] < 0:
                    cows += 1
                # If count[g] was positive, secret had this digit before
                if count[g] > 0:
                    cows += 1
                
                count[s] += 1
                count[g] -= 1
                
        return f"{bulls}A{cows}B"
