class Solution:
    def countSmaller(self, nums: list[int]) -> list[int]:
        # 1. Coordinate Compression: map values to ranks 1...N
        # This handles negative numbers and large ranges
        rank_map = {val: i + 1 for i, val in enumerate(sorted(set(nums)))}
        n = len(nums)
        m = len(rank_map)
        
        bit = [0] * (m + 1)
        
        def update(i):
            while i <= m:
                bit[i] += 1
                i += i & (-i)
                
        def query(i):
            s = 0
            while i > 0:
                s += bit[i]
                i -= i & (-i)
            return s
            
        counts = [0] * n
        
        # 2. Process from right to left
        for i in range(n - 1, -1, -1):
            rank = rank_map[nums[i]]
            # Query sum of frequencies for all ranks smaller than current
            counts[i] = query(rank - 1)
            # Update the BIT with the current rank
            update(rank)
            
        return counts
