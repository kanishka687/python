class Solution:
    def minSubarray(self, nums: list[int], p: int) -> int:
        target = sum(nums) % p
        if target == 0:
            return 0
        
        # Maps remainder -> most recent index where it occurred
        last_seen = {0: -1}
        cur_rem = 0
        min_len = len(nums)
        
        for i, num in enumerate(nums):
            cur_rem = (cur_rem + num) % p
            
            # We need: (cur_rem - prev_rem) % p == target
            # So: prev_rem = (cur_rem - target + p) % p
            needed_rem = (cur_rem - target + p) % p
            
            if needed_rem in last_seen:
                min_len = min(min_len, i - last_seen[needed_rem])
            
            # Update the index for the current remainder
            last_seen[cur_rem] = i
            
        # If min_len is still the whole array length, it's impossible 
        # (since we can't remove the entire array)
        return min_len if min_len < len(nums) else -1
