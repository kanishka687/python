class Solution:
    def prefixesDivBy5(self, nums: list[int]) -> list[bool]:
        answer = []
        current_num = 0
        
        for bit in nums:
            # Shift left by 1 (multiply by 2) and add the new bit
            # Apply modulo 5 immediately to keep the number small
            current_num = (current_num * 2 + bit) % 5
            
            # If current_num is 0, it means the binary prefix is divisible by 5
            answer.append(current_num == 0)
            
        return answer
