class Solution:
    def nthSuperUglyNumber(self, n: int, primes: list[int]) -> int:
        # ugly[i] will store the (i+1)th super ugly number
        ugly =  * n
        ugly = 1
        
        # pointers[j] is the index in 'ugly' to multiply with primes[j]
        pointers =  * len(primes)
        
        for i in range(1, n):
            # Find the minimum possible next super ugly number
            # Using a generator expression to find the min
            next_val = min(ugly[pointers[j]] * primes[j] for j in range(len(primes)))
            
            ugly[i] = next_val
            
            # Increment all pointers that resulted in the minimum value
            # This avoids duplicate entries in the 'ugly' array
            for j in range(len(primes)):
                if next_val == ugly[pointers[j]] * primes[j]:
                    pointers[j] += 1
                    
        return ugly[-1]
