class Solution:
    def countBits(self, n: int) -> list[int]:
        # Initialize array with zeros
        ans = [0] * (n + 1)
        
        for i in range(1, n + 1):
            # i >> 1 is i // 2
            # i & 1 is i % 2
            ans[i] = ans[i >> 1] + (i & 1)
            
        return ans
