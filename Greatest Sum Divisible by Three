class Solution:
    def maxSumDivThree(self, nums: list[int]) -> int:
        # dp[i] stores the maximum sum such that sum % 3 == i
        dp = [0, -float('inf'), -float('inf')]
        
        for num in nums:
            # We must use a copy or a new list to avoid using the same 
            # number twice for the same state update
            next_dp = dp[:]
            for current_sum in dp:
                if current_sum == -float('inf'):
                    continue
                
                new_sum = current_sum + num
                remainder = new_sum % 3
                
                # Update the state if the new sum is larger
                if new_sum > next_dp[remainder]:
                    next_dp[remainder] = new_sum
            dp = next_dp
            
        return dp[0]
