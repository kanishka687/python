class Solution:
    def countDigitOne(self, n: int) -> int:
        count = 0
        i = 1
        while i <= n:
            # Split n into High, Current, and Low parts
            # Example: n = 1234, i = 100
            # high = 12, curr = 3, low = 4
            high = n // (i * 10)
            curr = (n // i) % 10
            low = n % i
            
            if curr == 0:
                count += high * i
            elif curr == 1:
                count += high * i + (low + 1)
            else:
                count += (high + 1) * i
            
            i *= 10
            
        return count
