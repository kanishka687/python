class Solution:
    def increasingTriplet(self, nums: list[int]) -> bool:
        # Initialize with infinity
        first = float('inf')
        second = float('inf')
        
        for n in nums:
            if n <= first:
                # Update the smallest number
                first = n
            elif n <= second:
                # Update the second smallest number
                second = n
            else:
                # Found a number greater than both first and second
                return True
                
        return False
