class Solution:
    def wiggleSort(self, nums: list[int]) -> None:
        # 1. Sort the array
        nums.sort()
        
        # 2. Split into two halves
        mid = (len(nums) + 1) // 2
        small = nums[:mid]
        large = nums[mid:]
        
        # 3. Interweave from the back of each half
        # Reversing handles cases like [2, 2, 2, 3, 3] where middle values would clash
        nums[::2] = small[::-1]
        nums[1::2] = large[::-1]
