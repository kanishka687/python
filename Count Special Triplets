from collections import Counter

class Solution:
    def specialTriplets(self, nums: list[int]) -> int: # Changed name here
        n = len(nums)
        MOD = 10**9 + 7
        
        # Total counts of every number in the array
        right_counts = Counter(nums)
        # Counts of every number seen so far as we iterate
        left_counts = Counter()
        
        ans = 0
        
        for num in nums:
            # Current number is potentially the middle element 'j'
            # Remove it from the 'right' pool
            right_counts[num] -= 1
            
            target = num * 2
            
            # Ways to pick i (left) and k (right)
            count_i = left_counts[target]
            count_k = right_counts[target]
            
            if count_i > 0 and count_k > 0:
                ans = (ans + count_i * count_k) % MOD
            
            # Add current number to the 'left' pool for the next index
            left_counts[num] += 1
            
        return ans
