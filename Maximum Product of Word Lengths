class Solution:
    def maxProduct(self, words: list[str]) -> int:
        # Map bitmask to the maximum length of a word with that mask
        mask_map = {}
        
        for word in words:
            mask = 0
            for char in word:
                # Set the bit corresponding to the character
                mask |= (1 << (ord(char) - ord('a')))
            
            # Store only the longest length for each unique mask
            mask_map[mask] = max(mask_map.get(mask, 0), len(word))
            
        max_prod = 0
        masks = list(mask_map.keys())
        
        # Compare every pair of masks
        for i in range(len(masks)):
            for j in range(i + 1, len(masks)):
                # If bitwise AND is 0, they share no characters
                if masks[i] & masks[j] == 0:
                    max_prod = max(max_prod, mask_map[masks[i]] * mask_map[masks[j]])
                    
        return max_prod
