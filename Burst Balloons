class Solution:
    def maxCoins(self, nums: list[int]) -> int:
        # 1. Pad the array with 1s at both ends
        nums = [1] + [x for x in nums if x > 0] + [1]
        n = len(nums)
        
        # 2. Initialize DP table
        dp = [[0] * n for _ in range(n)]
        
        # 3. Iterate through all possible range lengths
        for length in range(1, n - 1):
            for i in range(n - length - 1):
                j = i + length + 1
                
                # 4. Try every balloon k as the LAST to burst in range (i, j)
                for k in range(i + 1, j):
                    coins = nums[i] * nums[k] * nums[j]
                    dp[i][j] = max(dp[i][j], dp[i][k] + coins + dp[k][j])
                    
        return dp[0][n - 1]
